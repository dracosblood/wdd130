body {
    font-family: Arial, sans-serif;
    margin: 2rem;
    background: #f4f4f4;
    display: flex;
    justify-content: center;
    background: #333;
}
section {
    background: #333;
    padding: 2rem;
    border-radius: 5px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
}
